<div class="container py-3">
  <h1>My Time Entries</h1>

  <div class="card mb-3">
    <div class="card-body">
      <%= form_with url: time_entries_path, method: :get, local: true, class: "row g-2" do %>
        <div class="col-md-3">
          <label class="form-label">Start date</label>
          <%= date_field_tag :start_date,
                @start_date,
                class: "form-control" %>
        </div>

        <div class="col-md-3">
          <label class="form-label">End date</label>
          <%= date_field_tag :end_date,
                @end_date,
                class: "form-control" %>
        </div>

        <div class="col-md-3">
          <label class="form-label">Category</label>
          <%= select_tag :category,
                options_for_select(
                  [
                    ["All", ""],
                    ["Task", "task"],
                    ["BAU", "bau"],
                    ["Project", "project"],
                    ["Curve Ball", "curve_ball"]
                  ],
                  params[:category]
                ),
                class: "form-select" %>
        </div>

        <div class="col-md-3 d-flex align-items-end">
          <%= submit_tag "Filter", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @time_entries.any? %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Started</th>
          <th>Ended</th>
          <th>Duration</th>
          <th>Category</th>
          <th>Ticket</th>
          <th>Task</th>
          <th>Project</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @time_entries.each do |entry| %>
          <tr>
            <td><%= entry.started_at&.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= entry.ended_at&.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= format_duration_hours(entry.hours) %></td>
            <td><%= human_category(entry.category) %></td>
            <td><%= entry.ticket_ref %></td>
            <td><%= entry.task_name %></td>
            <td><%= entry.project&.name %></td>
            <td>
              <%= link_to "Show", entry, class: "btn btn-sm btn-link" %>
              <%= link_to "Edit", edit_time_entry_path(entry), class: "btn btn-sm btn-link" %>
              <%= button_to "Delete",
                            entry,
                            method: :delete,
                            form: { data: { turbo_confirm: "Delete this entry?" } },
                            class: "btn btn-sm btn-link text-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= paginate @time_entries %>
  <% else %>
    <p class="text-muted">No entries found for this period.</p>
  <% end %>
</div>
