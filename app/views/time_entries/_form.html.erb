<%= form_with(model: time_entry, local: true) do |f| %>
  <% if time_entry.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(time_entry.errors.count, "error") %> prohibited this entry from being saved:</h4>
      <ul>
        <% time_entry.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :ticket_ref, "Ticket number", class: "form-label" %>
    <%= f.text_field :ticket_ref, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :task_name, "Task name", class: "form-label" %>
    <%= f.text_field :task_name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :description, "What was accomplished?", class: "form-label" %>
    <%= f.text_area :description, rows: 4, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :category, class: "form-label" %>
    <%= f.select :category,
          [
            ["Task", "task"],
            ["BAU", "bau"],
            ["Project", "project"],
            ["Curve Ball", "curve_ball"]
          ],
          {},
          class: "form-select" %>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <h5 class="card-title">Project</h5>

      <div class="mb-2">
        <label class="form-label">Existing projects you’ve used</label>
        <%= f.collection_select :project_id,
              @projects,
              :id,
              :name,
              { include_blank: "(Select existing project)" },
              class: "form-select" %>
      </div>

      <div class="mb-2">
        <%= f.label :new_project_name, "New project name", class: "form-label" %>
        <%= f.text_field :new_project_name, class: "form-control" %>
        <div class="form-text">
          Leave this blank to use the selected existing project.
        </div>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Back to Dashboard", dashboard_show_path, class: "btn btn-outline-secondary ms-2" %>
    <%= link_to "Entries", time_entries_path, class: "btn btn-outline-secondary ms-2" %>
  </div>

  <p class="mt-3">
    <%= link_to "Show this time entry", time_entry if time_entry.persisted? %> |
    <%= link_to "Back to time entries", time_entries_path %>
  </p>
<% end %>
