<div id="<%= dom_id time_entry %>">
  <p>
    <strong>User:</strong>
    <%= time_entry.user_id %>
  </p>

  <p>
    <strong>Ticket ref:</strong>
    <%= time_entry.ticket_ref %>
  </p>

  <p>
    <strong>Task name:</strong>
    <%= time_entry.task_name %>
  </p>

  <p>
    <strong>Notes:</strong>
    <%= time_entry.notes %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= time_entry.category %>
  </p>

  <p>
    <strong>Started at:</strong>
    <%= time_entry.started_at %>
  </p>

  <p>
    <strong>Ended at:</strong>
    <%= time_entry.ended_at %>
  </p>

  <p>
    <strong>Duration seconds:</strong>
    <%= time_entry.duration_seconds %>
  </p>

</div>
