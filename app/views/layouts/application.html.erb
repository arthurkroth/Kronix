<!DOCTYPE html>
<html>
  <head>
    <title>Kronix</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap 5 (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Chartkick (uses Chart.js by default) -->
    <%= javascript_include_tag "chartkick" %>
    <%= javascript_include_tag "Chart.bundle" %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="<%= authenticated_root_path rescue '/' %>">Kronix</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
            <% if user_signed_in? %>
              <li class="nav-item"><%= link_to "Entries", time_entries_path, class: "nav-link" %></li>
              <li class="nav-item">
                <%= button_to "Sign out",
                destroy_user_session_path,
                method: :delete,
                class: "nav-link btn btn-link p-0",
                form: { class: "d-inline" } %>
              </li>
            <% else %>
              <li class="nav-item"><%= link_to "Sign in", new_user_session_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Sign up", new_user_registration_path, class: "nav-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container py-3">
      <% flash.each do |k,v| %>
        <div class="alert alert-<%= k == 'notice' ? 'success' : 'warning' %>"><%= v %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
