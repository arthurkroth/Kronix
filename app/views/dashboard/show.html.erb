<div class="container py-3">
  <div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-3">Time Tracker</h1>
    <div>
      <% if @active_entry %>
        <%= button_to "Stop", stop_timer_path, method: :post, class: "btn btn-danger" %>
      <% else %>
        <%= form_with url: start_timer_path, method: :post, local: true, class: "d-inline" do |f| %>
          <%= hidden_field_tag :category, "task" %>
          <%= f.submit "Start Task", class: "btn btn-primary" %>
        <% end %>

        <%= form_with url: start_timer_path, method: :post, local: true, class: "d-inline ms-2" do |f| %>
          <%= hidden_field_tag :category, "bau" %>
          <%= f.submit "Start BAU", class: "btn btn-outline-primary" %>
        <% end %>

        <%= form_with url: start_timer_path, method: :post, local: true, class: "d-inline ms-2" do |f| %>
          <%= hidden_field_tag :category, "project" %>
          <%= f.submit "Start Project", class: "btn btn-outline-secondary" %>
        <% end %>

        <%= form_with url: start_timer_path, method: :post, local: true, class: "d-inline ms-2" do |f| %>
          <%= hidden_field_tag :category, "curve_ball" %>
          <%= f.submit "Start Curve Ball", class: "btn btn-outline-warning" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @active_entry %>
    <div class="alert alert-info">
      <strong>Active since:</strong>
      <%= @active_entry.started_at.strftime("%H:%M") %>
    </div>
  <% end %>

  <hr>

  <h3>Last 30 days (hours per day)</h3>
  <%= line_chart @by_day, xtitle: "Date", ytitle: "Hours" %>

  <h3 class="mt-4">Total time by category</h3>
  <%= pie_chart @by_category.transform_keys { |k| human_category(k) }, donut: true %>
</div>
