<div class="container py-3">
  <h1>My Team</h1>

  <div class="card mb-3">
    <div class="card-body">
      <%= form_with url: manager_team_path, method: :get, local: true, class: "row g-2" do %>
        <div class="col-md-5">
          <label class="form-label">Team member</label>
          <%= select_tag :member_id,
                options_for_select([["(select a member)", ""]] + @team_members.map { |m| [m.email, m.id] }, params[:member_id]),
                class: "form-select" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Start date</label>
          <%= text_field_tag :start_date, params[:start_date].presence || 1.month.ago.to_date.to_s, class: "form-control" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">End date</label>
          <%= text_field_tag :end_date, params[:end_date].presence || Date.current.to_s, class: "form-control" %>
        </div>
        <div class="col-md-1 d-flex align-items-end">
          <%= submit_tag "View", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @member %>
    <h3 class="mb-2"><%= @member.email %> – Entries</h3>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Started</th>
          <th>Ended</th>
          <th>Hours</th>
          <th>Category</th>
          <th>Ticket</th>
          <th>Task</th>
          <th>Project</th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |t| %>
          <tr>
            <td><%= t.started_at&.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= t.ended_at&.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= t.hours %></td>
            <td><%= t.category %></td>
            <td><%= t.ticket_ref %></td>
            <td><%= t.task_name %></td>
            <td><%= t.project&.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate @entries %>
  <% else %>
    <p class="text-muted">Pick a team member to view their entries.</p>
  <% end %>
</div>
