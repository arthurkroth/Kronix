<div class="container py-3">
  <h1>Edit User</h1>
  <p class="text-muted"><%= @user.email %></p>

  <%= form_with model: [:admin, @user], class: "mt-3" do |f| %>
    <div class="mb-3">
      <%= f.label :role %>
      <%= f.select :role, User.roles.keys, {}, class: "form-select" %>
    </div>

    <div class="mb-3">
      <%= f.label :manager_id, "Manager" %>
      <%= f.select :manager_id,
                   options_for_select([["(none)", nil]] + @managers.map { |m| [m.email, m.id] }, @user.manager_id),
                   {},
                   class: "form-select" %>
    </div>

    <%= f.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Back", admin_users_path, class: "btn btn-outline-secondary ms-2" %>
  <% end %>
</div>
